<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">
    <FrameLayout android:id="@+id/island_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start|top">
        <com.xuanyin.app.widget.IslandBackdropView
            android:id="@+id/island_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.xuanyin.app.widget.ChargingEffectView
            android:id="@+id/charging_effect"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <FrameLayout android:id="@+id/island_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">
            <include layout="@layout/island_collapsed" />
            <include layout="@layout/island_expanded" />
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/island_notif_card"
        android:layout_width="180dp" android:layout_height="40dp"
        android:layout_gravity="start|top" android:visibility="gone"
        android:background="@drawable/bg_notif_card"
        android:paddingHorizontal="12dp" android:paddingVertical="8dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔔" android:textSize="15sp" />
            <LinearLayout android:orientation="vertical"
                android:layout_marginStart="8dp" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:id="@+id/notif_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="通知" android:textColor="#FFFFFF"
                    android:textSize="12sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/notif_text"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text=""
                    android:textColor="#C9BFF5" android:textSize="11sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

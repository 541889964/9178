<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_deep" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="玄音设置" android:textColor="@color/white"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="折叠宽度 (30~95%)"
            android:textColor="@color/sub_text" android:textSize="13sp" />
        <SeekBar android:id="@+id/sb_collapsed" android:max="65"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_collapsed_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="62%"
            android:textColor="@color/white" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="折叠高度 (36~72dp)"
            android:textColor="@color/sub_text" android:textSize="13sp" />
        <SeekBar android:id="@+id/sb_height" android:max="36"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_height_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="44dp"
            android:textColor="@color/white" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="展开宽度 (60~100%)"
            android:textColor="@color/sub_text" android:textSize="13sp" />
        <SeekBar android:id="@+id/sb_expanded_w" android:max="40"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_expanded_w_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="94%"
            android:textColor="@color/white" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="展开高度 (120~500dp)"
            android:textColor="@color/sub_text" android:textSize="13sp" />
        <SeekBar android:id="@+id/sb_expanded_h" android:max="380"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_expanded_h_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="260dp"
            android:textColor="@color/white" android:textSize="13sp" />
        <TextView android:id="@+id/btn_alarm" android:layout_marginTop="30dp"
            android:padding="16dp" android:background="@drawable/bg_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⏰ 闹钟" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/btn_notify_access" android:layout_marginTop="12dp"
            android:padding="16dp" android:background="@drawable/bg_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="通知监听权限 →" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/btn_battery" android:layout_marginTop="12dp"
            android:padding="16dp" android:background="@drawable/bg_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="电池优化白名单 →" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/btn_test_notify" android:layout_marginTop="12dp"
            android:padding="16dp" android:background="@drawable/bg_gradient_button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="测试灵动岛通知分裂"
            android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/btn_announcement" android:layout_marginTop="12dp"
            android:padding="16dp" android:background="@drawable/bg_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="查看公告" android:textColor="@color/white" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

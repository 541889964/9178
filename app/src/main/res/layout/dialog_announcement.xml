<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_announcement"
        android:elevation="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center_horizontal">
            <View android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/bg_glow_circle"/>
            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="🎵" android:textSize="28sp"/>
        </FrameLayout>

        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="磁力快下 · 公告"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="v1.0.0 · 正式版"
            android:textColor="@color/sub_text"
            android:textSize="11sp"/>

        <View android:layout_width="40dp" android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tab_indicator"/>

        <ScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:maxHeight="360dp"
            android:scrollbars="none">

            <TextView android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D9C9BFF5"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp"/>
        </ScrollView>

        <FrameLayout android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient_button">
            <TextView android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="我已知晓"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

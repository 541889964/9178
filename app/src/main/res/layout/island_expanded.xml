<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded" android:visibility="gone"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none" android:fillViewport="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/group_life"
                android:orientation="vertical" android:padding="20dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/tv_time_big"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="14:30" android:textColor="#FFFFFF"
                    android:textSize="46sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_date"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="2026年10月2日 星期四"
                    android:textColor="#C9BFF5" android:textSize="13sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginVertical="14dp" android:background="#22FFFFFF" />
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏰" android:textSize="18sp" />
                    <TextView android:id="@+id/tv_alarm"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:layout_height="wrap_content"
                        android:text="未设置闹钟" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tv_battery_big"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="100%" android:textColor="#4CD964"
                        android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/group_music"
                android:orientation="vertical" android:padding="16dp"
                android:visibility="gone" android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/iv_cover_big"
                        android:layout_width="46dp" android:layout_height="46dp"
                        android:scaleType="centerCrop" />
                    <LinearLayout android:orientation="vertical"
                        android:layout_marginStart="12dp" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tv_song_title"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="未播放" android:textColor="#FFFFFF"
                            android:textSize="15sp" android:textStyle="bold"
                            android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/tv_song_artist"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="未知歌手"
                            android:textColor="#C9BFF5" android:textSize="12sp"
                            android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="vertical"
                    android:layout_marginTop="12dp" android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:id="@+id/lyric_line1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="2dp" android:text=""
                        android:textColor="#66FFFFFF" android:textSize="13sp"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/lyric_line2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="2dp" android:text=""
                        android:textColor="#B8FFFFFF" android:textSize="13sp"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/lyric_line3"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="2dp" android:text=""
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/lyric_line4"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="2dp" android:text=""
                        android:textColor="#B8FFFFFF" android:textSize="13sp"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/lyric_line5"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="2dp" android:text=""
                        android:textColor="#66FFFFFF" android:textSize="13sp"
                        android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp"
                    android:layout_marginTop="10dp" android:max="100" android:progress="30"
                    android:progressTint="#FF6B9D" />
                <LinearLayout android:orientation="horizontal" android:gravity="center"
                    android:layout_marginTop="6dp" android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:id="@+id/btn_prev"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp" android:paddingVertical="4dp"
                        android:text="⏮" android:textColor="#FFFFFF" android:textSize="24sp" />
                    <TextView android:id="@+id/btn_play"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp" android:paddingVertical="4dp"
                        android:text="⏸" android:textColor="#FFFFFF" android:textSize="28sp" />
                    <TextView android:id="@+id/btn_next"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp" android:paddingVertical="4dp"
                        android:text="⏭" android:textColor="#FFFFFF" android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>

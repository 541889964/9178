<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DyTool" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/pri</item>
        <item name="colorPrimaryVariant">@color/pri_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/txt</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorError">@color/err</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="materialButtonStyle">@style/Widget.DyTool.Button</item>
    </style>

    <style name="Widget.DyTool.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DyTool.Button.Primary" parent="Widget.DyTool.Button">
        <item name="backgroundTint">@color/pri</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DyTool.Button.Tonal" parent="Widget.DyTool.Button">
        <item name="backgroundTint">@color/surface2</item>
        <item name="android:textColor">@color/txt</item>
    </style>

    <style name="Widget.DyTool.Button.Green" parent="Widget.DyTool.Button">
        <item name="backgroundTint">@color/ok</item>
        <item name="android:textColor">#04240F</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DyTool.Button.Blue" parent="Widget.DyTool.Button">
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DyTool.Button.Orange" parent="Widget.DyTool.Button">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DyTool.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.DyTool.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DyTool.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>

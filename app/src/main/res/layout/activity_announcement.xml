<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_deep">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="24dp" android:scrollbars="none">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="玄音公告" android:textColor="@color/white"
                android:textSize="28sp" android:textStyle="bold" />
            <View android:layout_width="64dp" android:layout_height="3dp"
                android:layout_marginTop="10dp" android:background="@drawable/bg_gradient_button" />
            <TextView android:id="@+id/tv_announcement"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textColor="@color/sub_text"
                android:textSize="14sp" android:lineSpacingMultiplier="1.6" />
            <View android:layout_height="120dp" android:layout_width="match_parent" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/btn_agree"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="24dp" android:paddingHorizontal="56dp" android:paddingVertical="16dp"
        android:background="@drawable/bg_gradient_button"
        android:text="我已阅读并同意" android:textColor="@color/white"
        android:textSize="15sp" android:textStyle="bold" />
</FrameLayout>

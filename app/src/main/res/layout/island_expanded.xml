<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded" android:visibility="gone"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/group_life"
        android:orientation="vertical" android:padding="22dp"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/tv_time_big"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="14:30" android:textColor="#FFFFFF"
            android:textSize="52sp" android:textStyle="bold"
            android:maxLines="1" />
        <TextView android:id="@+id/tv_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="2026年10月2日 星期四"
            android:textColor="#C9BFF5" android:textSize="14sp" android:maxLines="1" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="18dp" android:background="#22FFFFFF" />
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏰" android:textSize="22sp" />
            <TextView android:id="@+id/tv_alarm"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="12dp" android:layout_height="wrap_content"
                android:text="未设置闹钟" android:textColor="#FFFFFF" android:textSize="16sp"
                android:maxLines="1" />
            <TextView android:id="@+id/tv_battery_big"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="100%" android:textColor="#4CD964"
                android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/group_music"
        android:orientation="vertical" android:padding="18dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                <com.xuanyin.app.widget.GlowRingView
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="center" />
                <ImageView android:id="@+id/iv_cover_big"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="center" android:scaleType="centerCrop" />
            </FrameLayout>
            <LinearLayout android:orientation="vertical"
                android:layout_marginStart="14dp" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:id="@+id/tv_song_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="未播放" android:textColor="#FFFFFF"
                    android:textSize="17sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_song_artist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="未知歌手"
                    android:textColor="#C9BFF5" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/lyric_container"
            android:orientation="vertical" android:gravity="center_vertical"
            android:layout_marginTop="14dp" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1">
            <com.xuanyin.app.widget.LyricLineView android:id="@+id/lyric_line1"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <com.xuanyin.app.widget.LyricLineView android:id="@+id/lyric_line2"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <com.xuanyin.app.widget.LyricLineView android:id="@+id/lyric_line3"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <com.xuanyin.app.widget.LyricLineView android:id="@+id/lyric_line4"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <com.xuanyin.app.widget.LyricLineView android:id="@+id/lyric_line5"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_marginTop="8dp" android:max="100" android:progress="30"
            android:progressTint="#FF6B9D" />
        <LinearLayout android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="8dp" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/btn_prev"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="22dp" android:paddingVertical="6dp"
                android:text="⏮" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:id="@+id/btn_play"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="22dp" android:paddingVertical="6dp"
                android:text="⏸" android:textColor="#FFFFFF" android:textSize="30sp" />
            <TextView android:id="@+id/btn_next"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="22dp" android:paddingVertical="6dp"
                android:text="⏭" android:textColor="#FFFFFF" android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

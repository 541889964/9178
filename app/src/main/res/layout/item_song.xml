<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="14dp" android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/iv_cover" android:layout_width="52dp"
        android:layout_height="52dp" android:scaleType="centerCrop" />
    <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/tv_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="示例歌曲"
            android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_sub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="歌手 · 专辑" android:textColor="@color/sub_text"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/tv_dur" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0:00"
        android:textColor="@color/weak_text" android:textSize="12sp" />
</LinearLayout>

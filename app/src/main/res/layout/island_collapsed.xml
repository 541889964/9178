<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_collapsed"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/group_life_mini"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/tv_time_mini"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="14:30" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        <View android:layout_width="2dp" android:layout_height="2dp"
            android:layout_marginHorizontal="8dp" android:background="#55FFFFFF" />
        <TextView android:id="@+id/tv_collapsed_title"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="10月2日" android:textColor="#C9BFF5" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_battery_mini"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="100%" android:textColor="#FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/group_music_mini"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/iv_cover_mini"
            android:layout_width="26dp" android:layout_height="26dp"
            android:scaleType="centerCrop" />
        <LinearLayout android:orientation="vertical"
            android:layout_marginStart="8dp" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/tv_song_title_mini"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="未播放" android:textColor="#FFFFFF"
                android:textSize="11sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="1dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/tv_lyric_mini"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="#C9BFF5" android:textSize="10sp"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_lyric2_mini"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:layout_height="wrap_content"
                    android:text="" android:textColor="#66FFFFFF" android:textSize="10sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="22dp" android:layout_height="18dp"
            android:layout_marginStart="4dp">
            <View android:layout_width="2.5dp" android:layout_height="7dp"
                android:layout_marginEnd="2dp" android:background="#FF6B9D" />
            <View android:layout_width="2.5dp" android:layout_height="12dp"
                android:layout_marginEnd="2dp" android:background="#9B6BFF" />
            <View android:layout_width="2.5dp" android:layout_height="9dp"
                android:layout_marginEnd="2dp" android:background="#FF6B9D" />
            <View android:layout_width="2.5dp" android:layout_height="14dp"
                android:layout_marginEnd="2dp" android:background="#9B6BFF" />
            <View android:layout_width="2.5dp" android:layout_height="5dp"
                android:background="#FF6B9D" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/group_download_mini"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⬇" android:textSize="14sp" android:textColor="#5AC8FA" />
        <LinearLayout android:orientation="vertical" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_width="0dp"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/tv_dl_title_mini"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="下载中" android:textColor="#FFFFFF" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/dl_bar_mini"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="2dp" android:max="100"
                android:progressTint="#5AC8FA" />
        </LinearLayout>
        <TextView android:id="@+id/tv_dl_pct_mini"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="0%"
            android:textColor="#5AC8FA" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
